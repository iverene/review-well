{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "server.js",
            "installCommand": "npm ci --no-audit --no-fund",
            "buildCommand": "pwd && ls node_modules | wc -l && ls node_modules/@prisma 2>&1; ls node_modules/express/package.json && npx prisma generate"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}