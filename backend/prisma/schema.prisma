generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewers Reviewer[]
}

model Reviewer {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  sourceType  String   // "upload" | "youtube" | "url"
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks Block[]
}

model Block {
  id         String   @id @default(uuid())
  reviewerId String
  type       String   // "qa" | "cloze" | "truefalse" | "mcq" | "ai"
  question   String
  answer     String
  options    Json?    // For MCQ options
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reviewer Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewerId, order])
}

model ReviewerRemix {
  id          String   @id @default(uuid())
  userId      String
  sourceId    String
  remixType   String   // "clone" | "build"
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId])
}

model ReviewSession {
  id         String   @id @default(uuid())
  userId     String
  reviewerId String
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  score      Int?
  totalCards Int?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
}

model ReviewerAnalytics {
  id         String   @id @default(uuid())
  reviewerId String
  date       DateTime @default(now())
  views      Int      @default(0)
  remixes    Int      @default(0)
  clones     Int      @default(0)

  reviewer Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, date])
}

model AiExtractionJob {
  id         String   @id @default(uuid())
  userId     String
  status     String   @default("pending") // "pending" | "processing" | "complete" | "failed"
  inputType  String   // "upload" | "youtube" | "url"
  inputUrl   String?
  inputText  String?
  result     Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
