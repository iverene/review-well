# Database (Supabase)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres"

# Session
SESSION_SECRET="generate-a-strong-random-string"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Backend URL
BACKEND_URL="http://localhost:3000"

# OpenRouter
OPENROUTER_API_KEY="sk-or-your-openrouter-api-key"

# Supabase Storage
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="uploads"

# Contact form via Resend's free tier (3,000 emails/month, no credit card).
# 1. Sign up at resend.com  2. Create an API key  3. Paste it below with
# the developer inbox that should receive contact messages.
CONTACT_EMAIL="you@example.com"
RESEND_API_KEY="re_your-resend-api-key"
# Optional once you verify a domain at resend.com/domains:
# RESEND_FROM="Review Well <hello@yourdomain.com>"
