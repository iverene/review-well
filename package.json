{
  "name": "review-well",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --prefix backend run dev & npm run dev --workspace=@review-well/frontend",
    "build": "npm run build --workspace=@review-well/frontend",
    "test": "npm run test --workspace=@review-well/frontend --if-present",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
